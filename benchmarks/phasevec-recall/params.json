{
  "datasets": {
    "nytimes-256-angular": {
      "url": "http://ann-benchmarks.com/nytimes-256-angular.hdf5",
      "sha256": null,
      "dims": 256
    }
  },
  "k": 10,
  "n_queries": 1000,
  "builds": 3,
  "reader": {"scale_percentile": 99.9, "code64_seed": 20261105},
  "versions": {"pgvector": "v0.8.1", "pg_phasevec": "v0.18.0", "postgresql_major": "18"},
  "settings": {"shared_buffers": "4GB", "work_mem": "64MB", "jit": "off",
               "max_parallel_workers_per_gather": "0"},
  "sweeps": {
    "pgvector.hnsw": {"build": {"m": 16, "ef_construction": 64},
                      "param": "hnsw.ef_search", "values": [10, 20, 40, 80, 120, 200, 400]},
    "pgvector.ivfflat": {"build": {"lists": 290},
                         "param": "ivfflat.probes", "values": [1, 2, 4, 8, 16, 32, 64]},
    "phasevec.find": {"build": {}, "param": "p_m", "values": [50, 100, 200, 400, 800]},
    "phasevec.find_ivf": {"build": {}, "param": "p_nprobe", "values": [1, 2, 4, 8, 16, 32],
                          "fixed": {"p_m": 200}}
  }
}
