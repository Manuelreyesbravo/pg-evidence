{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Manuelreyesbravo/pg-evidence/results/schema.json",
  "title": "pg-evidence result",
  "description": "One run of one benchmark: what ran, on what, from which commit, and the raw files (by sha256) every figure is computed from. Figures are recomputed by tools/derive.py; a stored figure that differs fails validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark", "id", "status", "date", "submitted_by", "run", "raw", "figures"],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark": {"type": "string", "enum": ["agent-gate-compare", "image-preflight", "phasevec-recall"]},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$"},
    "status": {
      "description": "cited: a published figure points at this run. submitted: a third-party or new run, shown next to the cited one, never quoted until promoted by a maintainer.",
      "type": "string", "enum": ["cited", "submitted"]
    },
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "submitted_by": {"type": "string", "minLength": 1},
    "notes": {"type": "string"},
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config", "harness_repo", "harness_commit", "run_url", "repeat", "seed", "versions", "hardware"],
      "properties": {
        "config": {"type": "string", "minLength": 1},
        "harness_repo": {"type": "string", "pattern": "^https://"},
        "harness_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "workflow_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "run_url": {"type": ["string", "null"], "pattern": "^https://"},
        "command": {"type": "string", "description": "The one command that reruns this configuration."},
        "repeat": {"type": "integer", "minimum": 1},
        "seed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "note"],
          "properties": {
            "value": {"type": ["integer", "null"]},
            "note": {"type": "string", "minLength": 1}
          }
        },
        "versions": {
          "type": "object",
          "description": "Every component that can change a figure, pinned. Use null for 'not recorded by this run', never a guess.",
          "additionalProperties": {"type": ["string", "null"]}
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {"type": "string"},
            "url": {"type": "string"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "context_tokens": {"type": "integer", "minimum": 1},
            "temperature": {"type": "number"}
          }
        },
        "hardware": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "cpu", "nproc", "mem_gib", "gpu"],
          "properties": {
            "kind": {"type": "string", "enum": ["github-hosted", "self-hosted", "workstation", "cloud-vm"]},
            "label": {"type": "string"},
            "cpu": {"type": ["string", "null"]},
            "nproc": {"type": ["integer", "null"], "minimum": 1},
            "mem_gib": {"type": ["number", "null"]},
            "gpu": {"type": ["string", "null"]},
            "shared": {"type": "boolean", "description": "true when other work ran on the machine; times from a shared machine are shown but never cited."}
          }
        }
      }
    },
    "raw": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "description": {"type": "string"}
        }
      }
    },
    "figures": {
      "type": "object",
      "description": "Written by tools/ingest.py from tools/derive.py; checked, never trusted.",
      "additionalProperties": {"type": ["string", "number", "integer", "boolean"]}
    }
  }
}
